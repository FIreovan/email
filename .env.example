# Mail Curl - 环境变量配置模板
# 复制此文件为 .dev.vars（本机开发用），实际部署请用 wrangler secret / wrangler.jsonc

# 收信网域（使用者拿到的地址会是 xxx@xzerox.xyz）
domain=xzerox.xyz

# 管理员登入帐号（不用是真实电邮，例如 admin；第一次登入时自动建立）
ADMIN_EMAIL=admin
ADMIN_PASSWORD=change-me-at-least-6-chars

# 可选配置
MAIL_PREFIX=
ALLOW_UNKNOWN_ADDRESSES=false

# Webhook 配置（可选）
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000

# 可选：给 curl 用的管理员 API Key
JWT_KEY=
