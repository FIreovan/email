{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mail-curl-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mail-curl-db",
			"database_id": "在这里填入你的 D1 database_id（运行 `npx wrangler d1 create mail-curl-db` 获取）"
		}
	],
	"vars": {
		// JWT 訪問密鑰 (必填)
		"JWT_KEY": "",
		// 郵箱域名 (必填，支持多域名，逗號分隔)
		// 單域名: "example.com"
		// 多域名: "example1.com,example2.com"
		// 支持泛域名: 配置 "example.com" 後，可接收 "@*.example.com" 的郵件
		"domain": "",
		// 郵箱前綴 (可選，未設置時使用隨機人名)
		"MAIL_PREFIX": "yoyomail",
		// === Webhook 配置 (可選) ===
		// 當 WEBHOOK_URL 和 WEBHOOK_SECRET 同時非空時，啟用 Webhook 收信模式
		// 收到郵件後直接轉發到你的後端 API，不走本地存儲
		"WEBHOOK_URL": "",
		"WEBHOOK_SECRET": "",
		"WEBHOOK_TIMEOUT_MS": "10000"
	}
}